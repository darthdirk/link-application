#include "logger-common.dtsi"

/* Hardware 1.1.0 schematic: TP4 = SDA/P1.02, TP5 = SCL/P1.03. */
/ {
	aliases {
		heartbeat-led = &green_led;
		onboard-environment = &bme688;
		magnetometer = &bmm150;
		color-sensor = &bh1749;
		low-power-accel = &adxl362;
		imu = &bmi270;
		battery-voltage = &vbatt;
		microphone = &pdm0;
	};
};

&pinctrl {
	logger_i2c_default: logger_i2c_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
				<NRF_PSEL(TWIM_SDA, 1, 2)>;
		};
	};

	logger_i2c_sleep: logger_i2c_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 3)>,
				<NRF_PSEL(TWIM_SDA, 1, 2)>;
			low-power-enable;
		};
	};

	/* VM3011 DATA and CLK on hardware 1.1.0, schematic sheet 2. */
	logger_pdm_default: logger_pdm_default {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 9)>,
				<NRF_PSEL(PDM_DIN, 0, 27)>;
		};
	};

	logger_pdm_sleep: logger_pdm_sleep {
		group1 {
			psels = <NRF_PSEL(PDM_CLK, 1, 9)>,
				<NRF_PSEL(PDM_DIN, 0, 27)>;
			low-power-enable;
		};
	};
};

/* Keep board-default rails enabled: 3V3 powers the green LED, and the switched
 * sensor rail powers the TP4/TP5 bus pull-ups. QSPI still uses DPD.
 */

&bme688 { status = "okay"; };
&bmm150 { status = "okay"; };
&bh1749 { status = "okay"; };
&adxl362 { status = "okay"; };
&bmi270 { status = "okay"; };
&spi3 { status = "okay"; };
&pwm1 { status = "disabled"; };
&adc {
	status = "okay";
	channel@2 {
		/* 1.5 Mohm / 180 kohm divider needs time to charge the SAADC input. */
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
	};
};
&vbatt {
	status = "okay";
	zephyr,pm-device-runtime-auto;
	power-on-sample-delay-us = <1000>;
};
/* Voltage is measured directly; there is no hardware state-of-charge gauge. */
&fuel_gauge { status = "disabled"; };

&clock {
	hfclkaudio-frequency = <12288000>;
};

&pdm0 {
	status = "okay";
	pinctrl-0 = <&logger_pdm_default>;
	pinctrl-1 = <&logger_pdm_sleep>;
	pinctrl-names = "default", "sleep";
	clock-source = "ACLK";
};
